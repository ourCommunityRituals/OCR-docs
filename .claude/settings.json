{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr list*)",
      "Bash(gh pr create*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(python3 tests/*)",
      "Bash(python3 scripts/*)",
      "Bash(python3 ocr-docs-brain/scripts/*)"
    ],
    "ask": [
      "Bash(gh pr merge*)",
      "Bash(gh api*)",
      "Bash(doppler *)"
    ],
    "deny": [
      "Bash(gh api * -X *)",
      "Bash(gh api -X *)",
      "Bash(gh api * --method *)",
      "Bash(gh api --method *)",
      "Bash(gh release*)",
      "Bash(gh secret*)",
      "Bash(gh variable*)",
      "Bash(gh workflow run*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo delete*)",
      "Bash(doppler secrets*)",
      "Bash(doppler configs tokens*)",
      "Bash(doppler service-tokens*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push * main*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * refs/tags/*)",
      "Bash(git tag*)",
      "Bash(wrangler deploy*)",
      "Bash(wrangler delete*)",
      "Bash(wrangler secret*)",
      "Bash(npx wrangler deploy*)",
      "Bash(npx wrangler delete*)",
      "Bash(npx wrangler secret*)",
      "Bash(pnpm exec wrangler deploy*)",
      "Bash(pnpm exec wrangler secret*)",
      "Bash(rm -rf*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)"
    ]
  }
}
